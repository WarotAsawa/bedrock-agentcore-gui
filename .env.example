VPC_ID=vpc-xxxxxxxxxxxxxxxxx
PUBLIC_SUBNET_IDS=subnet-xxxxxxxxxxxxxxxxx,subnet-yyyyyyyyyyyyyyyyy,subnet-zzzzzzzzzzzzzzzzz
PRIVATE_SUBNET_IDS=subnet-xxxxxxxxxxxxxxxxx,subnet-yyyyyyyyyyyyyyyyy,subnet-zzzzzzzzzzzzzzzzz
ALB_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
ECS_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx

# App Credentials (passed as ECS env vars)
